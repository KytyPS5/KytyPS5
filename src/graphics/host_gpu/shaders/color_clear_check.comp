#version 450

// Checks color metadata (DCC) on the GPU instead of reading it back. One workgroup handles one
// slice: if every byte of the slice holds the same code and that code is one of the candidates,
// the candidate's predicate is set to 1 (consumed by conditional clears) and, when requested,
// the slice is reset to 0xff ("no clear pending"), as the CPU path does after materializing.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Metadata {
    uint meta_words[];
};

layout(std430, binding = 1) writeonly buffer Predicates {
    uint predicates[];
};

layout(push_constant) uniform Params {
    uint meta_base;       // first word of slice 0 within the metadata binding
    uint slice_words;     // 32-bit words per slice
    uint pred_base;       // first predicate within the predicate binding
    uint code_count;      // candidate codes, at most 5
    uint codes_low;       // candidates 0-3, one byte each
    uint codes_high;      // candidate 4 in the low byte
    uint reset;           // nonzero: reset a matched slice to 0xff
} params;

shared uint s_mismatch;

uint CandidateCode(uint index) {
    return index < 4u ? (params.codes_low >> (8u * index)) & 0xffu : params.codes_high & 0xffu;
}

void main() {
    const uint slice = gl_WorkGroupID.x;
    const uint base  = params.meta_base + slice * params.slice_words;
    const uint first = meta_words[base];
    const uint code  = first & 0xffu;
    const uint expected = code * 0x01010101u;
    if (gl_LocalInvocationIndex == 0u) {
        s_mismatch = 0u;
    }
    barrier();

    bool mismatch = false;
    for (uint i = gl_LocalInvocationIndex; i < params.slice_words; i += 256u) {
        if (meta_words[base + i] != expected) {
            mismatch = true;
            break;
        }
    }
    if (mismatch) {
        atomicOr(s_mismatch, 1u);
    }
    barrier();

    const bool uniform_code = s_mismatch == 0u;
    bool matched = false;
    for (uint k = 0u; k < params.code_count; k++) {
        const bool hit = uniform_code && code == CandidateCode(k);
        matched = matched || hit;
        if (gl_LocalInvocationIndex == 0u) {
            predicates[params.pred_base + slice * params.code_count + k] = hit ? 1u : 0u;
        }
    }

    if (matched && params.reset != 0u) {
        for (uint i = gl_LocalInvocationIndex; i < params.slice_words; i += 256u) {
            meta_words[base + i] = 0xffffffffu;
        }
    }
}
