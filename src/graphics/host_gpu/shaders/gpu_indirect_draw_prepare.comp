#version 450
// Rewrites guest indirect draw arguments into host draw commands with the parameters the CPU
// path would emit, and keeps the NUM_INSTANCES the command processor latches.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Arguments {
	uint arguments[];
};

layout(std430, binding = 1) readonly buffer GuestCount {
	uint guest_count[];
};

// [0] draw count, then one host command per draw.
layout(std430, binding = 2) writeonly buffer Commands {
	uint commands[];
};

// NUM_INSTANCES after the draws recorded so far.
layout(std430, binding = 3) buffer Instances {
	uint instances_state;
};

layout(push_constant) uniform Parameters {
	uint max_count;
	uint stride_dwords;
	uint flags;
	uint arguments_base;
	uint count_base;
	uint instances;
} parameters;

const uint FlagIndexed       = 1u;
const uint FlagCountIndirect = 2u;
const uint FlagKeepOffsets   = 4u;
const uint FlagInstances     = 8u;

void main() {
	const uint index = gl_GlobalInvocationID.x;
	const uint count = (parameters.flags & FlagCountIndirect) != 0u
	                       ? min(guest_count[parameters.count_base], parameters.max_count)
	                       : parameters.max_count;
	if (index == 0u) {
		commands[0] = count;
		// The last executed draw latches its instance count; without one the value stays.
		if (count != 0u) {
			instances_state = arguments[parameters.arguments_base +
			                            (count - 1u) * parameters.stride_dwords + 1u];
		} else if ((parameters.flags & FlagInstances) != 0u) {
			instances_state = parameters.instances;
		}
	}
	if (index >= count) {
		return;
	}
	const uint base = parameters.arguments_base + index * parameters.stride_dwords;
	const bool keep = (parameters.flags & FlagKeepOffsets) != 0u;
	if ((parameters.flags & FlagIndexed) != 0u) {
		// Indices past the bound INDEX_BUFFER_SIZE read as zero, as on the hardware.
		const uint command = 1u + index * 5u;
		commands[command]      = arguments[base];
		commands[command + 1u] = arguments[base + 1u];
		commands[command + 2u] = arguments[base + 2u];
		commands[command + 3u] = keep ? arguments[base + 3u] : 0u;
		commands[command + 4u] = keep ? arguments[base + 4u] : 0u;
	} else {
		const uint command = 1u + index * 4u;
		commands[command]      = arguments[base];
		commands[command + 1u] = arguments[base + 1u];
		commands[command + 2u] = keep ? arguments[base + 2u] : 0u;
		commands[command + 3u] = keep ? arguments[base + 3u] : 0u;
	}
}
