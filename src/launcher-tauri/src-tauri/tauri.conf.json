{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kyty Launcher",
  "version": "0.1.0",
  "identifier": "io.github.kytyps5.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kyty Launcher",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "backgroundColor": "#050609"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
