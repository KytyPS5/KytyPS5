#version 450
#extension GL_GOOGLE_include_directive : require
layout(constant_id = 0) const uint ELEMENT_BYTES = 4u;
layout(constant_id = 1) const uint TILE = 0u;
const uint BLOCK_BYTES = 65536u;
#include "gpu_tiler_standard64_3d.inc"
uvec3 block_extent() { return standard64_3d_extent(); }
// Shifts branch on ELEMENT_BYTES; see standard64_3d_offset.
uint prt_3d_bits(uvec3 p, uint y0, uint x0, uint x1, uint z0) {
	return (((p.y >> y0) & 1u) << 10) ^ (((p.x >> x0) & 1u) << 10) ^
	       (((p.x >> x1) & 1u) << 11) ^ (((p.z >> z0) & 1u) << 11);
}
uint block_offset(uvec3 p) {
	uint offset = standard64_3d_offset(p);
	if (ELEMENT_BYTES == 1) return offset ^ prt_3d_bits(p, 4u, 5u, 4u, 4u);
	if (ELEMENT_BYTES == 2) return offset ^ prt_3d_bits(p, 4u, 4u, 3u, 4u);
	if (ELEMENT_BYTES == 4) return offset ^ prt_3d_bits(p, 4u, 4u, 3u, 3u);
	if (ELEMENT_BYTES == 8) return offset ^ prt_3d_bits(p, 3u, 4u, 3u, 3u);
	return offset ^ prt_3d_bits(p, 3u, 3u, 2u, 3u);
}
#include "gpu_tiler_common.inc"
