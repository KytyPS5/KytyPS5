#version 450
#extension GL_GOOGLE_include_directive : require
layout(constant_id = 0) const uint ELEMENT_BYTES = 4u;
layout(constant_id = 1) const uint TILE = 0u;
const uint BLOCK_BYTES = 65536u;
#include "gpu_tiler_standard64.inc"
// Sizes branch on ELEMENT_BYTES instead of building vectors from it: vector specialization-constant
// operations crash AMD's Windows compiler.
uvec3 block_extent() {
	if (ELEMENT_BYTES == 1) return uvec3(256, 256, 1);
	if (ELEMENT_BYTES == 2) return uvec3(256, 128, 1);
	if (ELEMENT_BYTES == 4) return uvec3(128, 128, 1);
	if (ELEMENT_BYTES == 8) return uvec3(128, 64, 1);
	return uvec3(64, 64, 1);
}
uint prt_bits(uvec3 p, uint x0, uint y0, uint x1, uint y1) {
	return (((p.x >> x0) & 1u) << 8) ^ (((p.y >> y0) & 1u) << 9) ^
	       (((p.x >> x1) & 1u) << 10) ^ (((p.y >> y1) & 1u) << 11);
}
uint block_offset(uvec3 p) {
	uint offset = standard64_offset(p.xy);
	if (ELEMENT_BYTES == 1) return offset ^ prt_bits(p, 7u, 7u, 6u, 6u);
	if (ELEMENT_BYTES == 2) return offset ^ prt_bits(p, 7u, 6u, 6u, 5u);
	if (ELEMENT_BYTES == 4) return offset ^ prt_bits(p, 6u, 6u, 5u, 5u);
	if (ELEMENT_BYTES == 8) return offset ^ prt_bits(p, 6u, 5u, 5u, 4u);
	return offset ^ prt_bits(p, 5u, 5u, 4u, 4u);
}
#include "gpu_tiler_common.inc"
